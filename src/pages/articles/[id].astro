---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { getArticles, articlePath, articleDate } from '../../articles';
import { SITE, personId } from '../../site';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const url = new URL(articlePath(entry.id), Astro.site).href;
const jsonLd = [
  {
    '@type': 'Article',
    '@id': url + '#article',
    headline: entry.data.title,
    description: entry.data.description,
    url,
    mainEntityOfPage: url,
    datePublished: articleDate(entry.data.date),
    inLanguage: SITE.locale,
    keywords: entry.data.tags.join(', '),
    author: { '@id': personId(Astro.site!) },
    isPartOf: { '@type': 'CollectionPage', name: '文章', url: new URL('/articles/', Astro.site).href },
  },
  { '@type': 'Person', '@id': personId(Astro.site!), name: SITE.name, url: new URL('/', Astro.site).href },
];
---
<Base title={entry.data.title + ' · ' + SITE.name} description={entry.data.description} type="article" jsonLd={jsonLd}>
  <div id="top"></div>
  <SiteHeader />
  <main>
    <article class="section article-page">
      <div class="container">
        <a class="back" href="/articles/">← 全部文章</a>
        <p class="meta"><time datetime={articleDate(entry.data.date)}>{articleDate(entry.data.date)}</time>{entry.data.tags.map((tag) => <span>#{tag}</span>)}</p>
        <h1>{entry.data.title}</h1>
        <p class="subtitle">{entry.data.description}</p>
        <div class="body glass"><Content /></div>
      </div>
    </article>
  </main>
  <SiteFooter />
</Base>
<style>
  .article-page { padding-top: 30px; }
  .container { max-width: 820px; }
  .back { display: inline-block; margin-bottom: 22px; font-size: .9rem; text-decoration: none; }
  .meta { display: flex; flex-wrap: wrap; gap: 4px 12px; margin: 0; font-size: .83rem; color: var(--ink-soft); }
  h1 { font-size: clamp(1.65rem, 4.8vw, 2.25rem); line-height: 1.45; margin: 8px 0 12px; }
  .subtitle { color: var(--ink-soft); margin: 0 0 28px; }
  .body { padding: clamp(20px, 5vw, 38px); overflow-wrap: anywhere; }
  .body :global(h2) { margin: 2.2em 0 .8em; font-size: 1.35rem; }
  .body :global(h3) { margin: 2em 0 .7em; font-size: 1.1rem; }
  .body :global(p) { margin: 1em 0; }
  .body :global(blockquote) { margin: 1.2em 0; padding: 4px 18px; border-left: 3px solid var(--accent); background: var(--chip-bg); }
  .body :global(a) { overflow-wrap: anywhere; }
  .body :global(hr) { border: 0; border-top: 1px solid var(--glass-border); margin: 2em 0; }
  @media (max-width: 480px) { .section { padding-top: 26px; } }
</style>
