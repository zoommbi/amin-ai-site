---
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { getArticles, articlePath, articleDate } from '../../articles';

const articles = await getArticles();
---
<Base title="文章 · 阿旻AI" description="关于 AI 原生组织、Agent 工作流和个人实践的长期文章。">
  <div id="top"></div>
  <SiteHeader />
  <main>
    <section class="section">
      <div class="container">
        <div class="section-head">
          <h1>文章</h1>
          <p>把重要的判断写长、写清楚，留下能够持续修正的实践记录。</p>
        </div>
        <div class="article-list">
          {articles.map((entry) => (
            <a class="article-card glass" href={articlePath(entry.id)}>
              <time datetime={articleDate(entry.data.date)}>{articleDate(entry.data.date)}</time>
              <h2>{entry.data.title}</h2>
              <p>{entry.data.description}</p>
              <div class="tags">{entry.data.tags.map((tag) => <span>#{tag}</span>)}</div>
            </a>
          ))}
          {articles.length === 0 && <p>文章整理中。</p>}
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>
<style>
  .section { padding-top: 36px; }
  .section-head h1 { font-size: 1.75rem; }
  .article-list { display: grid; gap: 16px; max-width: 800px; }
  .article-card { display: block; padding: 24px; color: inherit; text-decoration: none; }
  .article-card:hover, .article-card:focus-visible { border-color: var(--accent); outline: none; }
  .article-card time, .tags { color: var(--ink-soft); font-size: .85rem; }
  .article-card h2 { margin: 8px 0; font-size: 1.24rem; line-height: 1.55; }
  .article-card p { margin: 0; color: var(--ink-soft); }
  .tags { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 12px; }
  @media (max-width: 480px) { .article-card { padding: 20px; } }
</style>
