---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Intro from '../components/Intro.astro';
import JudgmentWall from '../components/JudgmentWall.astro';
import ProjectList from '../components/ProjectList.astro';
import LearningList from '../components/LearningList.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Icon from '../components/Icon.astro';
---
<Base>
  <div id="top"></div>
  <SiteHeader />
  <main>
    <Intro />

    <section id="judgments" class="section">
      <div class="container">
        <div class="section-head">
          <h2>
            <span class="icon-tile amber"><Icon name="lightbulb" /></span>
            我的判断
          </h2>
          <p>在实践中形成、仍在修正的看法。轻点便签看详细说明，再点收起。</p>
        </div>
        <JudgmentWall />
      </div>
    </section>

    <section id="projects" class="section">
      <div class="container">
        <div class="section-head">
          <h2>
            <span class="icon-tile teal"><Icon name="trending-up" /></span>
            项目进展
          </h2>
          <p>正在推进的事。名称已做泛化处理。</p>
        </div>
        <ProjectList />
      </div>
    </section>

    <section id="learning" class="section">
      <div class="container">
        <div class="section-head">
          <h2>
            <span class="icon-tile violet"><Icon name="map" /></span>
            正在学习
          </h2>
          <p>和 AI 一起梳理过的主题，整理成知识地图。点开地图，轻点知识块看细节。</p>
        </div>
        <LearningList />
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>
