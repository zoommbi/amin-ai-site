---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Intro from '../components/Intro.astro';
import JudgmentWall from '../components/JudgmentWall.astro';
import ProjectList from '../components/ProjectList.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Icon from '../components/Icon.astro';
---
<Base>
  <div id="top"></div>
  <SiteHeader />
  <main>
    <Intro />

    <section id="judgments" class="section">
      <div class="container">
        <div class="section-head">
          <h2>
            <span class="icon-tile amber"><Icon name="lightbulb" /></span>
            我的判断
          </h2>
          <p>一些短小的看法。轻点便签看详细说明，再点收起。</p>
        </div>
        <JudgmentWall />
      </div>
    </section>

    <section id="projects" class="section">
      <div class="container">
        <div class="section-head">
          <h2>
            <span class="icon-tile teal"><Icon name="trending-up" /></span>
            项目进展
          </h2>
          <p>正在推进的事。名称已做泛化处理。</p>
        </div>
        <ProjectList />
      </div>
    </section>

    <!-- 第三个板块预留位置（待定） -->
  </main>
  <SiteFooter />
</Base>
