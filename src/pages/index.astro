---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Intro from '../components/Intro.astro';
import JudgmentWall from '../components/JudgmentWall.astro';
import SiteFooter from '../components/SiteFooter.astro';
---
<Base>
  <div id="top"></div>
  <SiteHeader />
  <main>
    <Intro />

    <section id="judgments" class="section">
      <div class="container">
        <div class="section-head">
          <h2>📝 我的判断</h2>
          <p>一些短小的看法。轻点便签看详细说明，再点收起。</p>
        </div>
        <JudgmentWall />
      </div>
    </section>

    <section id="projects" class="section">
      <div class="container">
        <div class="section-head">
          <h2>📈 项目进展</h2>
          <p>项目卡片建设中。</p>
        </div>
      </div>
    </section>

    <!-- 第三个板块预留位置（待定） -->
  </main>
  <SiteFooter />
</Base>
