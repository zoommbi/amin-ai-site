---
import type { CollectionEntry } from 'astro:content';

// 知识地图：板块 → 知识块。轻点知识块弹出详细信息（手机底部抽屉 / 桌面居中面板）。
// 数据来自 src/content/maps/*.yaml，结构见 src/content.config.ts
interface Props {
  map: CollectionEntry<'maps'>;
}

const { map } = Astro.props;
const { regions } = map.data;

// 板块配色：轮换图标底座的四种色调
const TINTS = ['', 'amber', 'violet', 'teal'] as const;
const TILE_VARS = ['--tile-0', '--tile-1', '--tile-2', '--tile-3'];

const nodes = regions.flatMap((r, ri) => r.nodes.map((n) => ({ ...n, region: r, ri })));
const titleOf = new Map(nodes.map((n) => [n.id, n.title]));

// 详细说明按空行分段
const paragraphs = (s: string) =>
  s
    .split(/\n\s*\n/)
    .map((p) => p.trim())
    .filter(Boolean);
---
<div class="kmap">
  <div class="regions">
    {regions.map((r, ri) => (
      <section class="region glass" style={`--hue:var(${TILE_VARS[ri % 4]})`} aria-labelledby={`r-${r.id}`}>
        <header class="region-head">
          <span class:list={['icon-tile', 'sm', TINTS[ri % 4]]}>{ri + 1}</span>
          <div>
            <h3 id={`r-${r.id}`}>{r.title}</h3>
            {r.summary && <p>{r.summary}</p>}
          </div>
        </header>
        <ul class="nodes">
          {r.nodes.map((n) => (
            <li>
              <button type="button" class="node" data-node={n.id} aria-haspopup="dialog">
                <strong>{n.title}</strong>
                <span>{n.summary}</span>
              </button>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
  <p class="hint">轻点任一知识块查看详细信息</p>

  <dialog class="sheet" aria-labelledby="sheet-title">
    <div class="sheet-inner glass">
      <button type="button" class="close" aria-label="关闭">×</button>
      {nodes.map((n) => (
        <article class="card" data-card={n.id} hidden style={`--hue:var(${TILE_VARS[n.ri % 4]})`}>
          <p class="crumb">{n.ri + 1} · {n.region.title}</p>
          <h3>{n.title}</h3>
          <p class="lead">{n.summary}</p>
          {paragraphs(n.detail).map((p) => <p>{p}</p>)}
          {n.points.length > 0 && (
            <>
              <h4>要点</h4>
              <ul class="points">{n.points.map((p) => <li>{p}</li>)}</ul>
            </>
          )}
          {n.related.length > 0 && (
            <>
              <h4>相关</h4>
              <div class="related">
                {n.related
                  .filter((id) => titleOf.has(id))
                  .map((id) => (
                    <button type="button" class="chip" data-node={id}>{titleOf.get(id)}</button>
                  ))}
              </div>
            </>
          )}
          {n.questions.length > 0 && (
            <>
              <h4>继续问 AI</h4>
              <ul class="questions">
                {n.questions.map((q) => (
                  <li>
                    <span>{q}</span>
                    <button type="button" class="copy" data-copy={q}>复制</button>
                  </li>
                ))}
              </ul>
            </>
          )}
          {n.source && <p class="source">出处：{n.source}</p>}
        </article>
      ))}
    </div>
  </dialog>
</div>

<script>
  // 每张地图页只有一个 .kmap
  const root = document.querySelector<HTMLElement>('.kmap');
  const dialog = root?.querySelector<HTMLDialogElement>('dialog.sheet');
  if (root && dialog) {
    const cards = dialog.querySelectorAll<HTMLElement>('[data-card]');
    const inner = dialog.querySelector<HTMLElement>('.sheet-inner');

    const open = (id: string) => {
      let found = false;
      cards.forEach((c) => {
        const match = c.dataset.card === id;
        c.hidden = !match;
        if (match) {
          c.querySelector('h3')?.setAttribute('id', 'sheet-title');
          found = true;
        } else {
          c.querySelector('h3')?.removeAttribute('id');
        }
      });
      if (!found) return;
      if (inner) inner.scrollTop = 0;
      if (!dialog.open) dialog.showModal();
      history.replaceState(null, '', `#${id}`);
    };

    const close = () => dialog.close();
    dialog.addEventListener('close', () => {
      history.replaceState(null, '', location.pathname + location.search);
    });

    root.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const nodeBtn = t.closest<HTMLElement>('[data-node]');
      if (nodeBtn) return open(nodeBtn.dataset.node!);
      const copyBtn = t.closest<HTMLButtonElement>('[data-copy]');
      if (copyBtn) {
        navigator.clipboard?.writeText(copyBtn.dataset.copy!).then(() => {
          copyBtn.textContent = '已复制';
          setTimeout(() => (copyBtn.textContent = '复制'), 1500);
        });
        return;
      }
      if (t.closest('.close')) return close();
      // 点到面板外面的遮罩：关闭
      if (t === dialog) close();
    });

    // 网址带 #知识块id 时直接打开，方便分享
    const initial = decodeURIComponent(location.hash.slice(1));
    if (initial) open(initial);
  }
</script>

<style>
  .regions {
    display: grid;
    gap: 16px;
  }
  .region {
    padding: 16px;
    border-top: 3px solid var(--hue);
  }
  .region-head {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    margin-bottom: 12px;
  }
  .region-head .icon-tile {
    font-weight: 700;
    font-size: 0.95rem;
  }
  .region-head h3 {
    font-size: 1.05rem;
    margin-top: 2px;
  }
  .region-head p {
    margin: 2px 0 0;
    color: var(--ink-soft);
    font-size: 0.88rem;
    line-height: 1.6;
  }
  .nodes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .node {
    all: unset;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 2px;
    width: 100%;
    padding: 10px 12px 10px 14px;
    border-radius: 12px;
    cursor: pointer;
    color: var(--ink);
    background: var(--chip-bg);
    border: 1px solid var(--line-soft);
    transition:
      transform 0.2s ease,
      background 0.2s ease;
  }
  .node:hover {
    transform: translateY(-1px);
    border-color: var(--accent);
  }
  .node:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .node strong {
    font-size: 0.95rem;
  }
  .node span {
    font-size: 0.82rem;
    line-height: 1.55;
    color: var(--ink-soft);
  }
  .hint {
    margin: 14px 0 0;
    text-align: center;
    font-size: 0.8rem;
    color: var(--ink-soft);
  }

  /* 详情面板：手机是底部抽屉，桌面居中 */
  .sheet {
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--ink);
    width: 100%;
    max-width: 100%;
    max-height: 86vh;
    margin: auto 0 0;
  }
  .sheet::backdrop {
    background: rgba(0, 0, 0, 0.28);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }
  .sheet[open] {
    animation: rise 0.25s ease;
  }
  @keyframes rise {
    from {
      transform: translateY(24px);
      opacity: 0;
    }
  }
  .sheet-inner {
    position: relative;
    max-height: 86vh;
    overflow-y: auto;
    padding: 22px 20px 28px;
    border-radius: 22px 22px 0 0;
    background: var(--glass-fallback);
  }
  .close {
    all: unset;
    position: sticky;
    top: 0;
    float: right;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 999px;
    font-size: 1.3rem;
    line-height: 1;
    cursor: pointer;
    color: var(--ink-soft);
    background: var(--chip-bg);
    box-shadow: var(--chip-shadow);
    z-index: 1;
  }
  .close:focus-visible {
    outline: 2px solid var(--accent);
  }
  .card .crumb {
    margin: 0 0 4px;
    font-size: 0.8rem;
    color: var(--accent);
    font-weight: 600;
  }
  .card h3 {
    font-size: 1.35rem;
    padding-right: 40px;
  }
  .card .lead {
    margin: 8px 0 4px;
    padding: 10px 12px;
    border-radius: 12px;
    background: var(--chip-bg);
    font-family: var(--font-hand);
    font-size: 1.05rem;
  }
  .card p {
    margin: 12px 0 0;
    font-size: 0.95rem;
  }
  .card h4 {
    margin: 20px 0 6px;
    font-size: 0.85rem;
    color: var(--ink-soft);
    letter-spacing: 0.05em;
  }
  .points {
    margin: 0;
    padding-left: 1.2em;
    font-size: 0.95rem;
  }
  .related {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chip,
  .copy {
    all: unset;
    cursor: pointer;
    font-size: 0.85rem;
    padding: 4px 12px;
    border-radius: 999px;
    color: var(--accent);
    background: var(--chip-bg);
    box-shadow: var(--chip-shadow);
    border: 1px solid var(--line-soft);
  }
  .chip:focus-visible,
  .copy:focus-visible {
    outline: 2px solid var(--accent);
  }
  .questions {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .questions li {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-radius: 12px;
    border: 1px dashed var(--line-soft);
    font-size: 0.92rem;
  }
  .card .source {
    margin-top: 20px;
    padding-top: 10px;
    border-top: 1px dashed var(--line-soft);
    font-size: 0.8rem;
    color: var(--ink-soft);
  }
  .questions span {
    flex: 1;
  }
  .copy {
    flex-shrink: 0;
    font-size: 0.78rem;
    padding: 2px 10px;
  }

  @media (min-width: 768px) {
    .regions {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
    }
    .region {
      padding: 20px;
    }
    .sheet {
      max-width: 560px;
      margin: auto;
    }
    .sheet-inner {
      border-radius: 22px;
      padding: 28px 28px 32px;
      max-height: 80vh;
    }
  }
</style>
