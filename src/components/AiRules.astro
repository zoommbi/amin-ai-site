---
import Icon from './Icon.astro';

// 「我给 AI 定的规则」：针对 Persona 里的坑，我让 AI 怎么配合我。文案在 src/data/profile.ts 里改。
import { rules } from '../data/profile';
---
<section id="ai-rules" class="section">
  <div class="container">
    <div class="section-head">
      <h2>
        <span class="icon-tile"><Icon name="flame" /></span>
        我给 AI 定的规则
      </h2>
      <p>
        我容易想多、做少，AI 正好补上“火”：降低开始的门槛，把想法推成结果。为了让它帮我扬长避短，我和它约定了这几条。
      </p>
    </div>

    <ol class="rules">
      {rules.map((r, i) => (
        <li class="rule glass">
          <span class="num">{i + 1}</span>
          <div>
            <h3>{r.title}</h3>
            <p>{r.text}</p>
            <small>针对：{r.fixes}</small>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .rules {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .rule {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding: 16px 18px;
  }
  .num {
    flex-shrink: 0;
    display: inline-grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 999px;
    font-weight: 700;
    color: var(--accent);
    background: var(--accent-soft);
  }
  h3 {
    font-size: 1rem;
    margin-top: 2px;
  }
  p {
    margin: 4px 0 0;
    color: var(--ink-soft);
    font-size: 0.92rem;
  }
  small {
    display: inline-block;
    margin-top: 6px;
    font-size: 0.75rem;
    color: var(--ink-soft);
    opacity: 0.85;
  }
  @media (min-width: 768px) {
    .rules {
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }
    .rule {
      padding: 20px 22px;
    }
  }
</style>
