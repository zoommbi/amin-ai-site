---
import Icon from './Icon.astro';

// 「我给 AI 定的规则」：针对 Persona 里的坑，我让 AI 怎么配合我。文案在这里改。
const rules = [
  {
    title: '别陪我空想',
    text: '每轮讨论最后都要回答：这改变了什么行动？给我一个今天就能做的最小动作。',
    fixes: '想得太多',
  },
  {
    title: '先帮我把流程想清楚，再自动化',
    text: '流程没理顺就交给 Agent，只会把混乱放大。先编排，再自动化。',
    fixes: '想得太多',
  },
  {
    title: '提醒我修剪',
    text: '遇到新机会先问三件事：能强化我的根吗？服务我的目标吗？值得我亲自做吗？',
    fixes: '什么都接',
  },
  {
    title: '判断和责任归我',
    text: 'AI 分担信息处理和执行，帮我更快试错；但拍板、交付和担责，不外包。',
    fixes: '被外部要求带着走',
  },
];
---
<section id="ai-rules" class="section">
  <div class="container">
    <div class="section-head">
      <h2>
        <span class="icon-tile"><Icon name="flame" /></span>
        我给 AI 定的规则
      </h2>
      <p>
        我容易想多、做少，AI 正好补上“火”：降低开始的门槛，把想法推成结果。为了让它帮我扬长避短，我和它约定了这几条。
      </p>
    </div>

    <ol class="rules">
      {rules.map((r, i) => (
        <li class="rule glass">
          <span class="num">{i + 1}</span>
          <div>
            <h3>{r.title}</h3>
            <p>{r.text}</p>
            <small>针对：{r.fixes}</small>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .rules {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .rule {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding: 16px 18px;
  }
  .num {
    flex-shrink: 0;
    display: inline-grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 999px;
    font-weight: 700;
    color: var(--accent);
    background: var(--accent-soft);
  }
  h3 {
    font-size: 1rem;
    margin-top: 2px;
  }
  p {
    margin: 4px 0 0;
    color: var(--ink-soft);
    font-size: 0.92rem;
  }
  small {
    display: inline-block;
    margin-top: 6px;
    font-size: 0.75rem;
    color: var(--ink-soft);
    opacity: 0.85;
  }
  @media (min-width: 768px) {
    .rules {
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }
    .rule {
      padding: 20px 22px;
    }
  }
</style>
