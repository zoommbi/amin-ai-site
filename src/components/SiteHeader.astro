---
const links = [
  { href: '/', label: '我是谁' },
  { href: '/judgments/', label: '判断' },
  { href: '/projects/', label: '项目' },
  { href: '/learning/', label: '学习' },
];

// 当前页面的导航高亮
const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="site-header">
  <div class="container">
    <div class="bar glass">
      <a class="brand" href="/">阿旻<span>AI</span></a>
      <nav aria-label="页面导航">
        {links.map((l) => (
          <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>
        ))}
      </nav>
    </div>
  </div>
</header>

<style>
  /* 悬浮的玻璃导航条 */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    padding-top: 10px;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    height: 52px;
    padding: 0 8px 0 18px;
    border-radius: 999px;
  }
  .brand {
    font-family: var(--font-wordmark);
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }
  .brand span {
    color: var(--accent);
    margin-left: 0.06em;
  }
  nav {
    display: flex;
    gap: 4px;
    min-width: 0;
  }
  nav a {
    color: var(--ink-soft);
    text-decoration: none;
    font-size: 0.9rem;
    padding: 6px 8px;
    border-radius: 999px;
    white-space: nowrap;
  }
  nav a[aria-current='page'] {
    color: var(--accent);
    font-weight: 600;
  }
  nav a:hover,
  nav a:focus-visible {
    background: var(--chip-bg);
    box-shadow: var(--chip-shadow);
    color: var(--ink);
    outline: none;
  }
  @media (max-width: 360px) {
    .bar {
      padding-left: 14px;
    }
    nav a {
      padding: 6px 5px;
      font-size: 0.85rem;
    }
    /* 太窄放不下四个入口：「我是谁」和点字标回首页是一回事 */
    nav a:first-child {
      display: none;
    }
  }
</style>
