---
const links = [
  { href: '/judgments/', label: '思考' },
  { href: '/learning/', label: '学习' },
  { href: '/reading/', label: '书单' },
  { href: '/about/', label: '关于' },
];

const path = Astro.url.pathname;
const isCurrent = (href: string) => path.startsWith(href);
---

<header class="site-header">
  <div class="container">
    <div class="bar">
      <a class="brand" href="/" aria-label="阿旻AI，返回首页">阿旻<span>AI</span></a>
      <nav aria-label="主要导航">
        {links.map((link) => (
          <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>
        ))}
      </nav>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    background: var(--bg);
    border-bottom: 1px solid var(--line-soft);
  }
  .bar {
    min-height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .brand {
    font-family: var(--font-wordmark);
    font-weight: 700;
    font-size: 1.3rem;
    line-height: 1;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }
  .brand span { color: var(--accent); margin-left: .06em; }
  nav { display: flex; gap: clamp(6px, 1.8vw, 24px); flex: none; }
  nav a {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    min-height: 44px;
    padding: 8px 8px;
    color: var(--ink-soft);
    text-decoration: none;
    font-size: .9rem;
    font-weight: 550;
    white-space: nowrap;
    border-bottom: 2px solid transparent;
  }
  nav a[aria-current='page'] { color: var(--ink); border-color: var(--accent); }
  nav a:hover { color: var(--ink); }
  a:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  @media (max-width: 480px) {
    .bar { min-height: 62px; gap: 6px; }
    .brand { font-size: 1.09rem; }
    nav { gap: 0; }
    nav a { padding: 8px 6px; font-size: .83rem; }
  }
  @media (max-width: 350px) {
    .brand { font-size: 1rem; }
    nav a { padding: 7px 5px; font-size: .8rem; }
  }
</style>
