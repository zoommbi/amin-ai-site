---
// 首页右侧几何线稿：呼应「一个人，怎样获得过去只有组织才有的能力？」
// 参照 coss.com/ui 的工程线稿感，但主题换成阿旻的「一个人 ↔ 组织」意象。
// 纯装饰，aria-hidden，不影响可读性与结构化数据。
---
<svg class="hero-sketch" viewBox="0 0 420 250" role="img" aria-label="一个人与一个组织的几何示意图">
  <defs>
    <marker id="sk-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M2 1L8 5L2 9" fill="none" stroke="context-stroke" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
    </marker>
  </defs>

  <g class="grid">
    <line x1="40" y1="40" x2="380" y2="40" />
    <line x1="40" y1="90" x2="380" y2="90" />
    <line x1="40" y1="140" x2="380" y2="140" />
    <line x1="40" y1="190" x2="380" y2="190" />
    <line x1="80" y1="24" x2="80" y2="210" />
    <line x1="160" y1="24" x2="160" y2="210" />
    <line x1="240" y1="24" x2="240" y2="210" />
    <line x1="320" y1="24" x2="320" y2="210" />
  </g>

  <g class="measure">
    <line x1="80" y1="20" x2="320" y2="20" />
    <line x1="80" y1="16" x2="80" y2="24" />
    <line x1="320" y1="16" x2="320" y2="24" />
    <text x="200" y="14" text-anchor="middle">一个人 → 一个组织</text>
  </g>

  <g class="node-solo">
    <circle cx="112" cy="115" r="30" />
    <circle cx="112" cy="115" r="5" class="dot" />
    <text x="112" y="170" text-anchor="middle" class="cap">1 个人</text>
  </g>

  <g class="node-org">
    <rect x="248" y="66" width="104" height="98" rx="10" />
    <rect x="262" y="82" width="32" height="26" rx="4" />
    <rect x="304" y="82" width="32" height="26" rx="4" />
    <rect x="262" y="118" width="32" height="26" rx="4" />
    <rect x="304" y="118" width="32" height="26" rx="4" />
    <text x="300" y="190" text-anchor="middle" class="cap">N 个角色</text>
  </g>

  <g class="bridge">
    <line x1="150" y1="115" x2="238" y2="115" marker-end="url(#sk-arrow)" />
    <text x="194" y="104" text-anchor="middle" class="cap">AI</text>
  </g>

  <g class="measure vert">
    <line x1="374" y1="66" x2="374" y2="164" />
    <line x1="370" y1="66" x2="378" y2="66" />
    <line x1="370" y1="164" x2="378" y2="164" />
    <text x="388" y="118" text-anchor="middle" transform="rotate(90 388 118)">能力半径</text>
  </g>

  <g class="crosses">
    <path d="M40 115h10M45 110v10" />
    <path d="M370 115h10M375 110v10" />
  </g>
</svg>

<style>
  .hero-sketch {
    display: block;
    width: 100%;
    height: auto;
    color: var(--accent);
    fill: none;
  }
  .hero-sketch :global(.grid) line {
    stroke: var(--line-soft);
    stroke-width: 0.5;
    stroke-dasharray: 2 5;
  }
  .hero-sketch :global(.measure) line,
  .hero-sketch :global(.crosses) path {
    stroke: var(--line-soft);
    stroke-width: 0.75;
  }
  .hero-sketch :global(.measure) text,
  .hero-sketch :global(.cap) {
    fill: var(--ink-soft);
    font-family: var(--font-sans);
    font-size: 11px;
  }
  .hero-sketch :global(.node-solo) circle:not(.dot),
  .hero-sketch :global(.node-org) rect {
    stroke: var(--accent);
    stroke-width: 1.25;
  }
  .hero-sketch :global(.node-org) rect:not(:first-child) {
    stroke-width: 0.85;
    opacity: 0.55;
  }
  .hero-sketch :global(.dot) {
    fill: var(--accent);
  }
  .hero-sketch :global(.bridge) line {
    stroke: var(--accent);
    stroke-width: 1.4;
  }
</style>
