---
import { getCollection, render } from 'astro:content';

interface Props {
  featured?: boolean; // true 时只显示 featured: true 的判断（首页用）
}
const { featured = false } = Astro.props;

// 读取 src/content/judgments/ 下所有 Markdown，新的在前；draft: true 的不显示
const entries = (
  await getCollection('judgments', ({ data }) => !data.draft && (!featured || data.featured))
).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

// 只显示年月：很多判断只记录到形成的月份
const fmt = (d: Date) => d.toISOString().slice(0, 7).replace('-', '.');

const notes = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await render(entry);
    return { entry, Content };
  }),
);
---
<div class="wall">
  {notes.map(({ entry, Content }) => (
    <article class="note glass">
      <button
        type="button"
        class="note-face"
        aria-expanded="false"
        aria-controls={`judgment-${entry.id}`}
      >
        {entry.data.sample && <span class="badge">示例</span>}
        <span class="note-title">{entry.data.title}</span>
        <span class="note-meta">
          <time datetime={entry.data.date.toISOString().slice(0, 7)}>{fmt(entry.data.date)}</time>
          <span class="tags">
            {entry.data.tags.map((t) => <span class="tag">#{t}</span>)}
          </span>
        </span>
      </button>
      <div class="note-detail" id={`judgment-${entry.id}`} hidden>
        <Content />
        <p class="hint">轻点收起</p>
      </div>
    </article>
  ))}
</div>

<script>
  // 轻点卡片：原地展开 / 收起，不跳转
  document.querySelectorAll<HTMLElement>('.note').forEach((note) => {
    const face = note.querySelector<HTMLButtonElement>('.note-face');
    const detail = note.querySelector<HTMLElement>('.note-detail');
    if (!face || !detail) return;
    note.addEventListener('click', (e) => {
      // 详细说明里的链接正常打开，不触发收起
      if ((e.target as HTMLElement).closest('a')) return;
      const open = face.getAttribute('aria-expanded') === 'true';
      face.setAttribute('aria-expanded', String(!open));
      detail.hidden = open;
      note.classList.toggle('is-open', !open);
    });
  });
</script>

<style>
  /* 和首页其他卡片统一：白色玻璃卡片 */
  .wall {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
  }
  .note {
    cursor: pointer;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }
  .note:hover {
    transform: translateY(-2px);
    box-shadow:
      var(--glass-shadow),
      0 16px 34px -12px var(--shadow-tint);
  }
  .note-face {
    all: unset;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: 16px 18px;
    gap: 8px;
    color: var(--ink);
  }
  .note-face:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: var(--radius);
  }
  .badge {
    align-self: flex-start;
    font-size: 0.7rem;
    line-height: 1;
    padding: 4px 7px;
    border-radius: 999px;
    background: var(--chip-bg);
    box-shadow: var(--chip-shadow);
    color: var(--ink-soft);
  }
  .note-title {
    flex: 1;
    font-size: 1.02rem;
    line-height: 1.55;
    font-weight: 600;
  }
  .note-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 8px;
    font-size: 0.75rem;
    color: var(--ink-soft);
  }
  .tags {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .note-detail {
    margin: 0 18px;
    padding: 4px 0 14px;
    font-size: 0.92rem;
    color: var(--ink-soft);
    border-top: 1px dashed var(--line-soft);
  }
  .note-detail :global(p) {
    margin: 10px 0 0;
  }
  .note-detail .hint {
    font-size: 0.75rem;
    text-align: right;
  }
  @media (min-width: 768px) {
    .wall {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
      align-items: start;
    }
    .note-face {
      padding: 20px 22px;
      min-height: 150px;
    }
    .note-detail {
      margin: 0 22px;
    }
  }
</style>
