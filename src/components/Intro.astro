---
// 首页开头：我是谁。文案在这里改。
const focuses = ['信息编排', 'AI 工作流', '产品研发', '教育', '小项目实践'];
---
<section id="about" class="intro">
  <div class="container">
    <p class="hello">你好，我是</p>
    <h1>阿旻<span>AI</span></h1>
    <p class="lead">
      一个用 AI 重新组织工作的人。我关心的问题是：一个人，怎样获得过去只有组织才有的能力？
    </p>
    <p class="sub">
      这个网站是我的名片：我是什么样的人、怎么和 AI 一起工作、形成了哪些判断，都公开在这里。
    </p>
    <ul class="focus" aria-label="我关注的方向">
      {focuses.map((f) => <li>{f}</li>)}
    </ul>
  </div>
</section>

<style>
  .intro {
    padding: 48px 0 8px;
  }
  .hello {
    margin: 0;
    color: var(--ink-soft);
    font-family: var(--font-hand);
    font-size: 1.15rem;
  }
  h1 {
    font-family: var(--font-wordmark);
    font-weight: 700;
    font-size: 2.6rem;
    letter-spacing: 0.02em;
    margin: 4px 0 12px;
  }
  h1 span {
    color: var(--accent);
    margin-left: 0.06em;
  }
  .lead {
    font-size: 1.15rem;
    margin: 0 0 10px;
    max-width: 30em;
  }
  .sub {
    margin: 0 0 20px;
    color: var(--ink-soft);
    max-width: 34em;
  }
  .focus {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .focus li {
    font-size: 0.85rem;
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--chip-bg);
    box-shadow: var(--chip-shadow);
    color: var(--ink-soft);
  }
  @media (min-width: 768px) {
    .intro {
      padding: 88px 0 16px;
    }
    h1 {
      font-size: 3.4rem;
    }
    .lead {
      font-size: 1.3rem;
    }
  }
</style>
