---
import Icon from './Icon.astro';

// 简介区。文案为占位，阿旻后续替换。
const focuses = [
  { icon: 'workflow', tint: '', title: 'AI 工作流', text: '把 AI 接进日常工作，让重复的事自动跑起来。（占位）' },
  { icon: 'graduation-cap', tint: 'violet', title: '教育', text: '探索 AI 时代的学习方式，做一些课外的小尝试。（占位）' },
  { icon: 'flask-conical', tint: 'teal', title: '小项目实践', text: '用小步快跑的方式做真实的小项目，边做边学。（占位）' },
] as const;

const entries = [
  { href: '#judgments', title: '我的判断', desc: '一些短小的看法，写在便签上', icon: 'lightbulb', tint: 'amber' },
  { href: '#projects', title: '项目进展', desc: '正在推进的事，进度公开', icon: 'trending-up', tint: 'teal' },
] as const;
---
<section id="about" class="intro">
  <div class="container">
    <p class="hello">你好，我是</p>
    <h1>阿旻<span>AI</span></h1>
    <p class="lead">
      一个用 AI 做事、也在思考 AI 的人。这里记录我的判断和正在推进的项目。
      <em>（占位文案，之后替换）</em>
    </p>

    <ul class="focus">
      {focuses.map((f) => (
        <li class="glass">
          <span class:list={['icon-tile', f.tint]}><Icon name={f.icon} /></span>
          <div>
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </div>
        </li>
      ))}
    </ul>

    <div class="entries">
      {entries.map((e) => (
        <a class="entry glass" href={e.href}>
          <span class:list={['icon-tile', 'sm', e.tint]}><Icon name={e.icon} size={20} /></span>
          <span class="txt">
            <strong>{e.title}</strong>
            <small>{e.desc}</small>
          </span>
          <span class="arrow"><Icon name="arrow-down" size={18} stroke={2} /></span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .intro {
    padding: 48px 0 24px;
  }
  .hello {
    margin: 0;
    color: var(--ink-soft);
    font-family: var(--font-hand);
    font-size: 1.15rem;
  }
  h1 {
    font-size: 2.6rem;
    letter-spacing: 0.02em;
    margin: 4px 0 12px;
  }
  h1 span {
    color: var(--accent);
  }
  .lead {
    font-size: 1.05rem;
    margin: 0 0 28px;
    max-width: 36em;
  }
  .lead em {
    color: var(--ink-soft);
    font-style: normal;
    font-size: 0.85rem;
  }
  .focus {
    list-style: none;
    margin: 0 0 28px;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .focus li {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding: 16px 18px;
  }
  .focus h3 {
    font-size: 1rem;
    margin-top: 2px;
  }
  .focus p {
    margin: 2px 0 0;
    color: var(--ink-soft);
    font-size: 0.92rem;
  }
  .entries {
    display: grid;
    gap: 12px;
  }
  .entry {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    color: var(--ink);
    text-decoration: none;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }
  .entry:hover {
    transform: translateY(-2px);
    box-shadow:
      var(--glass-shadow),
      0 16px 34px -12px rgba(110, 65, 35, 0.28);
  }
  .entry:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .entry .txt {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
  }
  .entry small {
    color: var(--ink-soft);
  }
  .entry .arrow {
    display: inline-grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 999px;
    color: var(--accent);
    background: rgba(255, 255, 255, 0.6);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.9);
  }
  @media (min-width: 768px) {
    .intro {
      padding: 88px 0 32px;
    }
    h1 {
      font-size: 3.4rem;
    }
    .focus {
      grid-template-columns: repeat(3, 1fr);
    }
    .focus li {
      flex-direction: column;
      padding: 20px 22px;
    }
    .entries {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
